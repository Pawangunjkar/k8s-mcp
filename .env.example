# Kubernetes & Multi-Cloud / OpenShift Connection Details
# Pass via environment variables or connect dynamically via k8s_connect tool

# Path to kubeconfig file (leave blank to use in-cluster config or ~/.kube/config)
KUBECONFIG=

# Target kubeconfig context (optional)
K8S_CONTEXT=

# Default Kubernetes namespace or OpenShift project
K8S_NAMESPACE=default

# Provider hint: aws_eks | azure_aks | gcp_gke | openshift | generic_k8s
CLOUD_PROVIDER=

# Cloud-specific context hints (optional metadata)
AWS_REGION=
AZURE_SUBSCRIPTION_ID=
GCP_PROJECT=

# Default session identifier
K8S_SESSION=default

# Set to '1' to disable automatic environment connection on startup
# K8S_DISABLE_AUTOCONNECT=0
